# TraceVision Video Audit Dashboard - Environment Variables
# Copy this file to .env.local and fill in the values

# Google Gemini API Key (required for AI analysis)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend (Vercel) ---
# The full URL of your Render backend, used by the browser to call the API directly.
# Set this in Vercel → Project Settings → Environment Variables.
NEXT_PUBLIC_API_URL=https://your-render-service.onrender.com

# --- Next.js Server-Side API Routes (Vercel) ---
# Used by src/app/api/upload/route.ts and src/app/api/analyze/route.ts to proxy
# requests from Vercel serverless functions to the Render backend.
# Set this in Vercel → Project Settings → Environment Variables.
BACKEND_URL=https://your-render-service.onrender.com

# Node.js environment
NODE_ENV=development
