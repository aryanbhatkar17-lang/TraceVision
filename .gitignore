# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Ignore all env files...
.env*
# ...except for the public template
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local build caches
.freebuff/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pth

# Model weights (download separately)
backend/Epoch99.pth
